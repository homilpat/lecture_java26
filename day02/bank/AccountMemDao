package bank;

import java.util.Arrays;

public class AccountMemDao {
	public static int noSeq = 111111;
	Account[] accountDB = new Account[100];
	int numAccount = 0; // 초기화 명시
	
	// 계좌 등록
	public boolean insertAccount(String owner, String password, int balance) {
		// 배열이 꽉 찼는지 확인
		if (numAccount >= 100) {
			System.out.println("더 이상 계좌를 생성할 수 없습니다.");
			return false;
		}
		
		int no = noSeq++;
		accountDB[numAccount++] = new Account(no, owner, password, balance);
		
		return true; // 성공적으로 만들었으니 true 반환
	}
	
	// 계좌 조회
	public Account[] selectAll() {
		Account[] accountList = new Account[numAccount];
		for (int i = 0; i < numAccount; i++) {
			accountList[i] = accountDB[i];
		}
		return accountList;
	}
	//선택 계좌 조회 
	public Account getAccount(int accountNo) {
		for (int i = 0; i < numAccount; i++) {
			if (accountNo == accountDB[i].getNo()) {
				return accountDB[i]; // 일치하는 계좌를 찾으면 반환
			}
		}
		return null; // 못 찾으면 null 반환
	}
	// 출금
	public boolean withdraw(int accountNo, int amount) {
		for (int i = 0; i < numAccount; i++) {
			if (accountNo == accountDB[i].getNo()) { // 계좌를 찾았을 때
				if (amount <= accountDB[i].getBalance()) { // 잔액이 충분할 때
					// 잔액에서 출금액을 뺌 (-)
					accountDB[i].setBalance(accountDB[i].getBalance() - amount);
					return true;
				} else {
					System.out.println("잔액이 부족합니다.");
					return false;
				}
			}
		}
		// for문을 다 돌았는데도 계좌를 못 찾았을 때
		System.out.println("일치하는 계좌번호가 없습니다.");
		return false;
	}
	
	// 입금
	public boolean deposit(int accountNo, int amount) {
		for (int i = 0; i < numAccount; i++) {
			if (accountNo == accountDB[i].getNo()) { // 계좌를 찾았을 때
				// 잔액에 입금액을 더함 (+)
				accountDB[i].setBalance(accountDB[i].getBalance() + amount);
				return true;
			}
		}
		// for문을 다 돌았는데도 계좌를 못 찾았을 때
		System.out.println("일치하는 계좌번호가 없습니다.");
		return false;
	}

	@Override
	public String toString() {
		return "AccountMemDao [accountDB=" + Arrays.toString(accountDB) + ", numAccount=" + numAccount + "]";
	}
}
